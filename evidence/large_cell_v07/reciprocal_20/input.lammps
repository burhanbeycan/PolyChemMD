# Periodic assigned OPLS-AA model with explicit finite Ewald settings.
clear
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
dihedral_style opls
pair_style lj/cut/coul/long 10
pair_modify mix geometric shift no tail no table 0
dielectric 1.0
special_bonds lj/coul 0.0 0.0 0.5
read_data system.data
kspace_style ewald 1e-8
kspace_modify gewald 0.29999999999999999 kmax/ewald 20 20 20
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo 1
thermo_style custom step temp ebond eangle edihed evdwl ecoul elong pe
thermo_modify norm no format float %.17g
run 0
write_dump all custom forces.dump id mol x y z ix iy iz fx fy fz modify sort id format float %.17g
write_data singlepoint.data
print "POLYCHEMMD_RUN_COMPLETE"
